%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d1bb695a76d4654d8d9f794ee95e9f5, type: 3}
  m_Name: ChoiJeongNam
  m_EditorClassIdentifier: 
  npcName: "\uCD5C\uC815\uB0A8"
  randomDialogues:
  - "\uC5B4\uB5A4 \uC784\uBB34\uB97C \uCC98\uB9AC\uD560\uAC74\uAC00?"
  - "\uBB34\uC2A8\uC77C\uC774\uC9C0?"
  firstMeetDialogues:
  - lines:
    - "* F\uD0A4 \uD074\uB9AD *"
    - "\uC774\uC81C \uB9C9 \uD6C8\uB828\uC744 \uB9C8\uCE5C \uBAA8\uC591\uC778\uB370,
      \r\n\uBBF8\uC548\uD558\uC9C0\uB9CC \uBC14\uB85C \uC784\uBB34\uB97C \uBC1B\uC544\uC918\uC57C\uACA0\uC5B4."
    - "\uB108\uC758 \uCCAB \uBAA9\uD45C\uBB3C\uC740 \uC804\uD30C \uBC29\uD574 \uC7A5\uCE58\uB97C
      \uAC00\uC9C4 \uC790\uD0DD\uC5D0 \uC228\uC5B4\uC788\uB2E4, \r"
    - "\uC704\uC131, \uB4DC\uB860, \uC5F4 \uAC10\uC9C0\uAE30 \uBAA8\uB450 \uBB34\uB825\uD654\uB3FC\uC11C
      \uC678\uBD80\uC5D0\uC120 \r\n\uB0B4\uBD80 \uC9C0\uB3C4\uB97C \uC5BB\uC744 \uC218
      \uC5C6\uC5B4."
    - "\uB108\uC758 \uB208\uACFC \uC9C1\uAC10\uC73C\uB85C \uC801\uC744 \uCC3E\uC544
      \uC81C\uAC70\uD574\uC57C\uD574. \r\n\uAC01\uC624 \uB2E8\uB2E8\uD788 \uD558\uACE0
      \uCD9C\uBC1C\uD558\uB3C4\uB85D."
  lockedStageDialogues:
  - lines:
    - "\uBA3C\uC800 \uD574\uC57C \uD560 \uC77C\uC774 \uC788\uC9C0 \uC54A\uC544?"
  - lines:
    - "\uBA3C\uC800 \uD574\uC57C \uD560 \uC784\uBB34\uAC00 \uC788\uC744 \uAC70\uC57C."
  stage1ClearDialogues:
  - lines:
    - "* F\uD0A4 \uD074\uB9AD *"
    - "\uB180\uB78D\uAD70, \uC194\uC9C1\uD788 \uC8FD\uC744 \uC904 \uC54C\uC558\uB294\uB370"
    - "\uB2E4\uC74C \uC784\uBB34\uB294 \uC6D0\uC7A5\uACFC \uBD80\uC6D0\uC7A5 \uC81C\uAC70\uC57C...
      \uADF8\uB7F0\uB370 \uBB38\uC81C\uAC00 \uC880 \uC788\uC5B4."
    - "\uC815\uCC30\uD300\uC758 \uBCF4\uACE0\uC5D0 \uB530\uB974\uBA74 \uC81C\uAC70
      \uB300\uC0C1\uC774 \uAE08\uBC29 \uC774\uB3D9\uD560 \r\n\uC608\uC815\uC774\uB77C\uACE0
      \uD558\uB354\uAD70."
    - "\uB300\uC0C1\uC774 \uC774\uB3D9 \uD560 \uC7A5\uC18C\uB294 \uC54C\uC544\uB0C8\uC9C0\uB9CC
      \uB0B4\uBD80 \uAD6C\uC870\uB97C \r\n\uC54C\uC544\uB0B4\uAE30\uC5D4 \uC2DC\uAC04\uC774
      \uBD80\uC871\uD574."
    - "\uC5B4\uCA54 \uC218 \uC5C6\uC9C0\uB9CC \uC790\uB124\uAC00 \uB2E4\uC2DC \uD55C\uBC88
      \uC704\uD5D8\uC744 \uAC10\uC218 \uD574\uC918\uC57C\uACA0\uC5B4."
  stage2ClearDialogues:
  - lines:
    - "* F\uD0A4 \uD074\uB9AD *"
    - "\uC5B4\uB824\uC6B4 \uC784\uBB34\uB97C \uD574\uB0B4\uB2E4\uB2C8, \uC2E4\uB825\uC774
      \uB300\uB2E8\uD558\uAD70."
    - ".....\uBBF8\uC548\uD558\uC9C0\uB9CC \uB2E4\uC74C \uC784\uBB34\uB3C4 \uAC00\uC918\uC57C\uACA0\uB2E4."
    - "\uC815\uCC30\uD300\uC774 \uBC18 \uC774\uC0C1 \uB2F9\uD588\uC5B4.. \uBB3C\uB860
      \uC81C\uAC70 \uB300\uC0C1\uC778 \r\n\uBC15\uC0AC\uB4E4\uC740 \uAE09\uD558\uAC8C
      \uB3C4\uB9DD\uAC00\uB294 \uC911\uC774\uACE0."
    - "\uBC15\uC0AC\uB4E4\uC758 \uCD5C\uC885 \uB3C4\uB9DD \uC7A5\uC18C\uB294 \uBC84\uB824\uC9C4
      \uB9C8\uC57D \uC81C\uC870\uC5F0\uAD6C\uC18C\uC57C, \r\n\uAC70\uAE38 \uC218\uB9AC\uD574\uC11C
      \uC5F0\uAD6C\uC18C\uB85C \uC7AC\uAC00\uB3D9 \uD558\uB824\uB294 \uBAA8\uC591\uC774\uB354\uAD70."
    - "\uCD5C\uB300\uD55C \uBE68\uB9AC \uC81C\uAC70\uD574\uC57C\uD574, \uC815\uCC30
      \uC815\uBCF4\uB294 \uC5C6\uACA0\uC9C0\uB9CC \uC9C0\uAE08\uAE4C\uC9C0\r\n\uC798
      \uD574\uC654\uC73C\uB2C8 \uC774\uBC88\uC5D0\uB3C4 \uBBFF\uACE0 \uC788\uACA0\uC5B4."
    - "\uC900\uBE44\uB418\uC5C8\uB2E4\uBA74 \uCD9C\uBC1C\uD558\uB3C4\uB85D."
  stage3ClearDialogues:
  - lines:
    - "* F\uD0A4 \uD074\uB9AD *"
    - "\uC5F0\uAD6C\uC18C \uC784\uBB34\uB3C4 \uC131\uACF5\uD558\uB2E4\uB2C8\u2026
      \uB0A0 \uB180\uB77C\uAC8C \uD558\uB294\uAD70."
    - "\uBC15\uC0AC\uB4E4\uC774 \uB0A8\uAE34 \uC790\uB8CC \uB355\uBD84\uC5D0 \uC870\uC9C1\uC758
      \n\uC720\uD1B5\uB9DD \uC77C\uBD80\uB97C \uD30C\uC545\uD560 \uC218 \uC788\uC5C8\uC5B4."
    - "\uADF8\uB188\uB4E4\uC740 \uB2E8\uC21C\uD55C \uC81C\uC870\uAC00 \uC544\uB2C8\uB77C
      \uC720\uD1B5\uAE4C\uC9C0\n\uC190\uC744 \uBED7\uCE58\uACE0 \uC788\uC5C8\uB358
      \uBAA8\uC591\uC774\uC57C."
    - "\uADF8\uB798\uC11C \uB2E4\uC74C \uC784\uBB34\uB294 \u2018\uC720\uD1B5\uBCF4\uAD00\uC18C\u2019\uB2E4,
      \uC9C0\uAE08\uAE4C\uC9C0\uC640\uB294 \uB2E4\uB97C \uAC70\uC57C."
    - "\uC5B4\uCC28\uD53C \uC790\uB124\uD55C\uD14C\uB294 \uC26C\uC6B4 \uC784\uBB34\uAC00
      \uB418\uACA0\uC9C0\uB9CC \uB9D0\uC774\uC9C0."
  stage4ClearDialogues:
  - lines:
    - "* F\uD0A4 \uD074\uB9AD *"
    - "\uC5ED\uC2DC \uC608\uC0C1\uBCF4\uB2E4 \uD6E8\uC52C \uBE60\uB974\uAD70, \uBCF4\uAD00\uC18C\uB97C
      \uC644\uC804\uD788 \uC7A5\uC545\uD558\uB2E4\uB2C8."
    - "\uC774\uC81C \uBB38\uC81C\uB294 \uC720\uD1B5\uCC45\uC758 \uB2E4\uC74C \uD589\uBCF4\uC778\uB370\n\uC6C0\uC9C1\uC784\uC774
      \uBD84\uBA85 \uAE09\uD574\uC9C8 \uAC70\uC57C."
    - "\uC815\uCC30\uD300 \uBCF4\uACE0\uC5D0 \uB530\uB974\uBA74, \uC720\uD1B5\uB9DD\uC774\n\uD769\uC5B4\uC9C8
      \uAC00\uB2A5\uC131\uC774 \uB192\uB2E4\uACE0 \uD558\uB354\uAD70."
    - "\uC790\uB124 \uB355\uBD84\uC5D0 \uD070 \uD53C\uD574\uB294 \uB9C9\uC558\uC9C0\uB9CC,
      \uC5EC\uC804\uD788\n\uAE34\uC7A5\uC758 \uB048\uC744 \uB193\uC744 \uC218 \uC5C6\uC5B4."
    - "\uB2E4\uC74C \uC784\uBB34\uB3C4 \uC27D\uC9C0 \uC54A\uC9C0\uB9CC\u2026 \uBBFF\uACE0
      \uB9E1\uAE30\uACA0\uB124."
  stage5ClearDialogues:
  - lines:
    - "* F\uD0A4 \uD074\uB9AD *"
    - "\uD1B5\uC2E0 \uC791\uC5C5\uC7A5\uAE4C\uC9C0 \uCC98\uB9AC\uD558\uB2E4\uB2C8,
      \n\uC790\uB124 \uC2E4\uB825\uC740 \uC815\uB9D0 \uBBFF\uC74C\uC9C1\uD558\uAD70."
    - "\uC870\uC9C1\uC758 \uD575\uC2EC \uD1B5\uC2E0\uB9DD\uC744 \uB9C8\uBE44\uC2DC\uCF30\uC5B4,\n\uC774\uC81C
      \uC678\uBD80\uC640\uB294 \uC644\uC804\uD788 \uB2E8\uC808\uB420 \uAC70\uC57C."
    - "\uD558\uC9C0\uB9CC \uB0A8\uC740 \uC801\uB4E4\uC740 \uB9C8\uC9C0\uB9C9 \uC800\uD56D\uC744\n\uC900\uBE44\uD558\uACE0
      \uC788\uC744 \uAC00\uB2A5\uC131\uC774 \uB192\uC544."
    - "\uBB50\u2026 \uC9C0\uAE08\uAE4C\uC9C0 \uC790\uB124\uAC00 \uD574\uC628 \uAC78
      \uBCF4\uBA74\n\uCDA9\uBD84\uD788 \uD574\uB0BC \uC218 \uC788\uACA0\uC9C0\uB9CC."
    - "\uADF8\uB7F0\uB370 \uC544\uC9C1 \uC804\uB2EC\uBC1B\uC740 \uC784\uBB34\uAC00
      \uC5C6\uC5B4,\n\uC26C\uACE0 \uB300\uAE30\uD558\uACE0 \uC788\uB3C4\uB85D \uD574!"
