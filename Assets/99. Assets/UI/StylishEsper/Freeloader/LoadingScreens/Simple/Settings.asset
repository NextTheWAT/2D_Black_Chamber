  backgroundDisplayLength: 10
  enableBackgroundZoom: 1
  showTips: 1
  tips:
  - "\uB6F8 \uB54C\uB294 \uC2A4\uD0DC\uBBF8\uB098\uAC00 \uB2F3\uC2B5\uB2C8\uB2E4.
    \uC870\uC2EC!"
  - "Shift\uB97C \uB204\uB974\uBA74 \uB2EC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC801\uC744 \uB9DE\uCD94\uAE30 \uC5B4\uB835\uB2E4\uBA74 \uC624\uB978\uCABD
    \uB9C8\uC6B0\uC2A4\uB97C \uAFB9 \uB20C\uB7EC\uBCF4\uC138\uC694!"
  - "\uC870\uC900 \uAC8C\uC774\uC9C0\uB294 \uC7AC\uC0AC\uC6A9 \uC2DC\uAC04\uC774
    \uD544\uC694\uD569\uB2C8\uB2E4."
  - "\uC801\uC774 \uBB3C\uC74C\uD45C\uAC00 \uB72C\uB2E4\uBA74 \uC870\uC2EC\uD558\uC138\uC694,
    \uC758\uC2EC \uC911\uC774\uB2C8\uAE4C\uC694!"
  - "\uC801\uC2DC\uC57C \uBE68\uAC04\uC0C9\uC5D0 \uB2FF\uC73C\uBA74 \uACF5\uACA9\uD569\uB2C8\uB2E4.
    \uC870\uC2EC!"
  - "\uBC14\uB2E5\uC744 \uC798 \uBD10\uC8FC\uC138\uC694, \uB9C9\uD78C \uBB38\uC744
    \uC5F4\uC5B4\uC904 \uCE74\uB4DC\uAC00 \uC788\uC744\uC9C0 \uBAA8\uB974\uB2C8\uAE4C\uC694!"
  - "\uC5F4\uB9AC\uC9C0 \uC54A\uB294 \uBB38\uC774 \uC788\uB2E4\uBA74 \uCE74\uB4DC\uD0A4\uB85C
    \uC9C0\uB098\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  tipsTitle: Tip
  tipDisplayLength: 12
  requireInputToContinue: 1
  continueText: "\uC544\uBB34 \uBC84\uD2BC\uC774\uB098 \uB20C\uB7EC\uC8FC\uC138\uC694"
