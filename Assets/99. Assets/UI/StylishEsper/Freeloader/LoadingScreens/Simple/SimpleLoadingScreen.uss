.paragraph {
    color: rgb(198, 198, 198);
    font-size: 24px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    letter-spacing: 4px;
    word-spacing: 4px;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.h1 {
    color: rgb(255, 255, 255);
    font-size: 36px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
    -unity-font-style: normal;
}

.loadingBar {
    flex-grow: 1;
    max-height: 24px;
    background-color: rgb(255, 255, 255);
    transition-duration: 0.4s;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.tipsContainer {
    max-width: 40%;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    background-color: rgba(0, 0, 0, 0.5);
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.heightFull {
    max-height: 100%;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
    transition-delay: 0s;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.heightZero {
    max-height: 0;
    transition-duration: 0.5s;
    transition-delay: 0s;
    transition-timing-function: ease-in-out;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

:root {
  /* 전역으로 갈무리 적용 */
  -unity-font-definition: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}


.root:disabled {
    opacity: 0;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.fadeOut {
    opacity: 0;
    transition-duration: 0.5s;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.fadeIn {
    opacity: 1;
    transition-duration: 0.5s;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.background {
    max-width: 100%;
    max-height: 100%;
    min-width: 100%;
    min-height: 100%;
    flex-grow: 1;
    position: absolute;
    transition-duration: 0.5s;
    opacity: 1;
    transition-delay: 0s;
    transition-property: opacity;
    -unity-background-scale-mode: scale-and-crop;
    -unity-font: url("project://database/Assets/08.%20Fonts/Galmuri11.ttf?fileID=12800000&guid=c4ef8635877ff6448b2f8ab81f33d67e&type=3#Galmuri11");
}

.background:disabled {
    opacity: 0;
}

.scaleDown {
    scale: 1 1;
    transition-property: scale;
    transition-duration: 3s;
    transition-delay: 1s;
    transition-timing-function: ease-in-out;
}

.scaleUp {
    scale: 1.05 1.05;
    transition-property: scale;
    transition-duration: 3s;
    transition-delay: 1s;
    transition-timing-function: ease-in-out;
}
